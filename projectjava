import java.util.*;

class Car {
    int id;
    String name;
    boolean available;

    Car(int id, String name) {
        this.id = id;
        this.name = name;
        this.available = true;
    }
}

class Customer {
    int id;
    String name;

    Customer(int id, String name) {
        this.id = id;
        this.name = name;
    }
}

class RentalSystem {

    ArrayList<Car> cars = new ArrayList<>();
    HashMap<Integer, Customer> customers = new HashMap<>();
    Queue<Customer> waitingList = new LinkedList<>();

    void addCar(int id, String name) {
        cars.add(new Car(id, name));
    }

    void showCars() {
        for (Car c : cars) {
            System.out.println(c.id + " " + c.name + " Available: " + c.available);
        }
    }

    void rentCar(int carId, Customer customer) {

        for (Car c : cars) {
            if (c.id == carId && c.available) {
                c.available = false;
                customers.put(carId, customer);
                System.out.println("Car rented successfully to " + customer.name);
                return;
            }
        }

        waitingList.add(customer);
        System.out.println("Car not available. Added to waiting list.");
    }

    void returnCar(int carId) {

        for (Car c : cars) {
            if (c.id == carId) {
                c.available = true;
                customers.remove(carId);
                System.out.println("Car returned successfully");
                return;
            }
        }
    }
}

public class projectdsa{

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        RentalSystem rs = new RentalSystem();

        rs.addCar(1, "Mahindra Thar");
        rs.addCar(2, "Mahindra XUV700");
        rs.addCar(3, "Mahindra Scorpio");

        while (true) {

            System.out.println("\n1. Show Cars");
            System.out.println("2. Rent Car");
            System.out.println("3. Return Car");
            System.out.println("4. Exit");

            System.out.print("Enter choice: ");
            int choice = sc.nextInt();

            if (choice == 1) {

                rs.showCars();

            } else if (choice == 2) {

                System.out.print("Enter Customer ID: ");
                int cid = sc.nextInt();
                sc.nextLine();

                System.out.print("Enter Customer Name: ");
                String cname = sc.nextLine();

                System.out.print("Enter Car ID to Rent: ");
                int carId = sc.nextInt();

                Customer c = new Customer(cid, cname);
                rs.rentCar(carId, c);

            } else if (choice == 3) {

                System.out.print("Enter Car ID to Return: ");
                int carId = sc.nextInt();

                rs.returnCar(carId);

            } else if (choice == 4) {

                System.out.println("Thank You");
                break;
            }
        }
    }
}dsa
